# Copy this file to backend/.env and fill in your database credentials.
# Supabase: use the Session pooler URI from Connect > ORMs (SQLAlchemy).
# It should use postgresql+psycopg:// and include sslmode=require.
# Local default:
DATABASE_URL=sqlite:///./healthguard.db
# Supabase production example:
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Comma-separated origins allowed to call the API (the Next.js dev server).
CORS_ORIGINS=http://localhost:3000

# Bootstrap staff accounts (created on startup if missing).
ADMIN_EMAIL=acefin24@gmail.com
MHO_EMAIL=healthguard.irosin@gmail.com

# Required for registration — verification codes are sent by email only.
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=HealthGuard AI
